{
  "name": "control-claude-code",
  "version": "0.2.2",
  "type": "module",
  "description": "Revive Claude Code Remote Control for BYOK users by injecting the Bun-compiled binary via inspector and re-hosting the /remote-control control-plane on a self-run server.",
  "keywords": [
    "claude",
    "claude-code",
    "remote-control",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DotRacel/control-claude-code.git"
  },
  "homepage": "https://github.com/DotRacel/control-claude-code#readme",
  "bugs": "https://github.com/DotRacel/control-claude-code/issues",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "control-claude": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "server": "node src/server/main.ts",
    "control": "node src/control-cli.ts",
    "control-headless": "node src/control-cli.ts --headless",
    "extract-anchors": "node src/injector/extract-anchors.ts",
    "start": "node src/cli.ts",
    "capture-events": "node test/capture-events.ts",
    "probe-interactive": "node test/probe-interactive.ts",
    "e2e-interactive": "bash test/e2e-interactive.sh",
    "e2e-question": "bash test/e2e-question.sh",
    "e2e-plan-mode": "bash test/e2e-plan-mode.sh",
    "e2e-persist": "bash test/e2e-persist.sh",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U ccc -d ccc",
    "test": "node --test test/protocol.test.ts test/server.test.ts test/auth.test.ts test/fixtures.test.ts test/transcript.test.ts test/model.test.ts test/web-channel.test.ts test/pwa.test.ts test/push-event.test.ts test/control-cli.test.ts test/db.test.ts test/profiles.test.ts test/update-check.test.ts test/qr.test.ts test/deeplink.test.ts test/i18n.test.ts test/task-notification.test.ts",
    "export-history": "bash scripts/export-history.sh",
    "history-audit": "node test/history-audit.ts",
    "shape-report": "node test/shape-report.ts",
    "verify-injection": "node test/verify-injection.ts",
    "test-spawn-chain": "node test/test-spawn-chain.ts",
    "render-history": "node test/render-history.ts",
    "ui-preview": "node test/ui-preview.ts",
    "ui-shot": "node test/ui-shot.ts",
    "ui-check": "node test/ui-shot.ts --device desktop",
    "deeplink-browser": "node test/deeplink-browser.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "esbuild": "^0.25.0",
    "pg": "^8.23.0"
  }
}
