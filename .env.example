# Copy to .env (gitignored) or export in your shell.
# Matches docker-compose.yml's db service.
DATABASE_URL=postgres://ccc:ccc@127.0.0.1:5432/ccc

# The invite code every registration must present. REQUIRED to let anyone sign up: with this
# unset, /v1/auth/register refuses everything (a default-open gate would be no gate at all).
INVITE_CODE=change-me

# Server bind (main.ts defaults: 8787 / 0.0.0.0 so a phone on the LAN can reach it)
# PORT=8787
# HOST=0.0.0.0

# How far back to load sessions into the in-memory read cache on boot (default 30). With
# retention on (below) this is effectively capped by the TTL — nothing older is left to load.
# CCC_LOAD_WINDOW_DAYS=30

# Retention: sessions nobody has touched in this many days are DELETED, transcript and all.
# Swept once at boot and hourly after that. A session whose claude is still connected is never
# swept, however quiet it has been. 0 turns retention off — the list then only ever grows.
# CCC_SESSION_TTL_DAYS=7
